{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ingles-sem-legendas",
  "compatibility_date": "2026-10-19",
  "build": {
    "command": "npm run build",
    "watch_dir": "public"
  },
  "assets": {
    "directory": "./dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  }
}
